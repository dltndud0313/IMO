#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

EXERCISE="${1:-pushup}"
SPEED="${2:-1.0}"
INTENSITY="${3:-1.0}"
WS_HOST="${4:-0.0.0.0}"
WS_PORT="${5:-8765}"
UI_HOST="${6:-0.0.0.0}"
UI_PORT="${7:-8080}"

cd "${ROOT_DIR}"

./device/esp32/scripts/run_mock_workout_stream.sh \
  --exercise "${EXERCISE}" \
  --loop \
  --speed "${SPEED}" \
  --intensity "${INTENSITY}" \
  --format binary | \
python3 device/raspberry-pi/mock_pi_sensor_bridge.py \
  --input-file - \
  --ws-host "${WS_HOST}" \
  --ws-port "${WS_PORT}" \
  --ui-host "${UI_HOST}" \
  --ui-port "${UI_PORT}"
