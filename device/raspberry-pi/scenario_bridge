#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

EXERCISE="${1:-pushup}"
SCENARIO="${2:-good}"
SPEED="${3:-normal}"
REPS="${4:-6}"
WS_HOST="${5:-0.0.0.0}"
WS_PORT="${6:-8765}"
UI_HOST="${7:-0.0.0.0}"
UI_PORT="${8:-8080}"

cd "${ROOT_DIR}"

python3 device/raspberry-pi/mock_sensor_scenario_stream.py \
  --exercise "${EXERCISE}" \
  --scenario "${SCENARIO}" \
  --speed "${SPEED}" \
  --reps "${REPS}" \
  --realtime | \
python3 device/raspberry-pi/mock_pi_sensor_bridge.py \
  --input-file - \
  --ws-host "${WS_HOST}" \
  --ws-port "${WS_PORT}" \
  --ui-host "${UI_HOST}" \
  --ui-port "${UI_PORT}" \
  --auto-exercise "${EXERCISE}" \
  --auto-sets 1 \
  --auto-reps "${REPS}" \
  --auto-rest-sec 30 \
  --auto-start
