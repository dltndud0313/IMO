// C203 백엔드 자동 배포 파이프라인
// - GitLab develop 브랜치 변경 시 트리거 (수동 + webhook 둘 다 가능)
// - 같은 EC2 위에서 docker compose 재기동
// - 운영용 .env 는 ${BACKEND_DIR}/.env 에 미리 두고 compose 가 자동 로드
// - Mattermost 알림은 Phase 7 에서 mm-webhook-c203 credential 추가 후 활성화

pipeline {
    agent any

    environment {
        DEPLOY_DIR   = '/home/ubuntu/S14P31C203'
        BACKEND_DIR  = '/home/ubuntu/S14P31C203/backend'
        COMPOSE_FILE = 'docker-compose.ec2.yml'
        HEALTH_URL   = 'http://127.0.0.1:8000/'
        GIT_REPO_URL = 'lab.ssafy.com/s14-final/S14P31C203.git'
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Pull develop') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'gitlab-c203-pat',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        cd "$DEPLOY_DIR"

                        # 자동 인증을 위해 임시 credential helper 등록 (값은 메모리 inline, 디스크 저장 X)
                        git -c "credential.helper=!f() { echo username=$GIT_USER; echo password=$GIT_TOKEN; }; f" \\
                            fetch origin develop

                        git checkout develop
                        git reset --hard origin/develop
                        echo "==> 배포 대상 커밋:"
                        git log --oneline -1
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh '''
                    set -eu
                    cd "$BACKEND_DIR"
                    docker compose -f "$COMPOSE_FILE" build
                '''
            }
        }

        stage('Up') {
            steps {
                sh '''
                    set -eu
                    cd "$BACKEND_DIR"
                    docker compose -f "$COMPOSE_FILE" up -d
                    docker compose -f "$COMPOSE_FILE" ps
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    set -eu
                    for i in $(seq 1 10); do
                        code=$(curl -sS -o /dev/null -w "%{http_code}" "$HEALTH_URL" || echo "000")
                        if [ "$code" = "200" ]; then
                            echo "Health check OK (HTTP $code)"
                            exit 0
                        fi
                        echo "Attempt $i: HTTP $code, retrying in 3s..."
                        sleep 3
                    done
                    echo "Health check failed after 10 attempts"
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            // 오래된 dangling 이미지 정리 (디스크 공간 관리)
            sh 'docker image prune -f --filter "until=24h" 2>/dev/null || true'
        }
        success {
            echo '배포 성공'
            // Phase 7: 아래 주석 해제 + mm-webhook-c203 credential 등록
            // withCredentials([string(credentialsId: 'mm-webhook-c203', variable: 'MM_URL')]) {
            //     sh '''
            //         curl -sS -X POST "$MM_URL" \\
            //           -H "Content-Type: application/json" \\
            //           -d "{\\"text\\":\\":jenkins7: 백엔드 배포 성공 — ${BUILD_URL}\\"}"
            //     '''
            // }
        }
        failure {
            echo '배포 실패'
            // withCredentials([string(credentialsId: 'mm-webhook-c203', variable: 'MM_URL')]) {
            //     sh '''
            //         curl -sS -X POST "$MM_URL" \\
            //           -H "Content-Type: application/json" \\
            //           -d "{\\"text\\":\\":angry_jenkins: 백엔드 배포 실패 — ${BUILD_URL}\\"}"
            //     '''
            // }
        }
    }
}
