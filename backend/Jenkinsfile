// C203 백엔드 자동 배포 파이프라인
// - GitLab develop 브랜치 변경 시 트리거 (수동 + webhook 둘 다 가능)
// - 같은 EC2 위에서 docker compose 재기동
// - 운영용 .env 는 ${BACKEND_DIR}/.env 에 미리 두고 compose 가 자동 로드
// - Mattermost 알림 포맷은 C206 운영 패턴 (이모지 + 커밋 정보 + 빌드 보기 링크)

import groovy.json.JsonOutput

def notifyMattermost(String emoji, String title) {
    // Pull develop 단계에서 capture 한 커밋 정보 사용. 그 단계 전에 죽으면 '-'.
    def sha = env.DEPLOY_SHA ?: '-'
    def msg = env.DEPLOY_MSG ?: '-'

    def commitText = msg
    if (sha != '-') {
        commitText = "[${msg}](${env.REPO_WEB_URL}/-/commit/${sha})"
    }

    def text = "# ${emoji} ${title}\n\n" +
               "**알림**: @here\n" +
               "**브랜치**: develop\n" +
               "**커밋**: ${commitText}\n" +
               "**Jenkins**: [빌드 보기](${env.BUILD_URL})"

    // JsonOutput.toJson 으로 escape 안전 처리 (한글/특수문자/줄바꿈 모두 OK)
    def json = JsonOutput.toJson([text: text])
    writeFile file: 'mm-payload.json', text: json

    withCredentials([string(credentialsId: 'mm-webhook-c203', variable: 'MM_URL')]) {
        sh 'curl -sS -X POST "$MM_URL" -H "Content-Type: application/json; charset=utf-8" -d @mm-payload.json'
    }
}

pipeline {
    agent any

    environment {
        DEPLOY_DIR   = '/home/ubuntu/S14P31C203'
        BACKEND_DIR  = '/home/ubuntu/S14P31C203/backend'
        COMPOSE_FILE = 'docker-compose.ec2.yml'
        HEALTH_URL   = 'http://127.0.0.1:8000/'
        REPO_WEB_URL = 'https://lab.ssafy.com/s14-final/S14P31C203'
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Pull develop') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'gitlab-c203-pat',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        cd "$DEPLOY_DIR"

                        # 자동 인증을 위해 임시 credential helper 등록 (값은 메모리 inline, 디스크 저장 X)
                        git -c "credential.helper=!f() { echo username=$GIT_USER; echo password=$GIT_TOKEN; }; f" \\
                            fetch origin develop

                        git checkout develop
                        git reset --hard origin/develop
                        echo "==> 배포 대상 커밋:"
                        git log --oneline -1
                    '''
                }
                // 알림용 커밋 정보 capture
                script {
                    env.DEPLOY_SHA = sh(returnStdout: true, script: "cd $DEPLOY_DIR && git log --format='%H' -1").trim()
                    env.DEPLOY_MSG = sh(returnStdout: true, script: "cd $DEPLOY_DIR && git log --format='%s' -1").trim()
                }
            }
        }

        stage('Build') {
            steps {
                sh '''
                    set -eu
                    cd "$BACKEND_DIR"
                    docker compose -f "$COMPOSE_FILE" build
                '''
            }
        }

        stage('Up') {
            steps {
                sh '''
                    set -eu
                    cd "$BACKEND_DIR"
                    docker compose -f "$COMPOSE_FILE" up -d
                    docker compose -f "$COMPOSE_FILE" ps
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    set -eu
                    for i in $(seq 1 10); do
                        code=$(curl -sS -o /dev/null -w "%{http_code}" "$HEALTH_URL" || echo "000")
                        if [ "$code" = "200" ]; then
                            echo "Health check OK (HTTP $code)"
                            exit 0
                        fi
                        echo "Attempt $i: HTTP $code, retrying in 3s..."
                        sleep 3
                    done
                    echo "Health check failed after 10 attempts"
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            sh 'docker image prune -f --filter "until=24h" 2>/dev/null || true'
        }
        success {
            echo '배포 성공'
            script { notifyMattermost(':jenkins7:', 'Deploy 성공 ✅ [test]') }
        }
        failure {
            echo '배포 실패'
            script { notifyMattermost(':angry_jenkins:', 'Deploy 실패 ❌ [test]') }
        }
    }
}
