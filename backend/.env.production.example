# EC2 운영용 환경변수 템플릿
# 실제 값을 채워서 EC2 ~/S14P31C203/backend/.env.production 으로 복사
# 절대 Git 에 커밋하지 말 것 (.gitignore 로 .env.production 차단됨)
#
# 시크릿 생성 예: openssl rand -base64 48

POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
JWT_SECRET=CHANGE_ME_random_32bytes_or_more
JWT_REFRESH_SECRET=CHANGE_ME_different_random_32bytes_or_more

# 모바일 앱이 주 클라이언트라 CORS 의미 약함. 와일드카드 유지하거나 도메인 화이트리스트 지정
CORS_ORIGINS=*

# (선택) 토큰 만료 시간 — 기본값 사용 시 생략 가능
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=14
